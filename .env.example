# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lira_grand_hotel?schema=public"

# Auth
JWT_SECRET="replace-with-a-long-random-secret-in-production"
ADMIN_SESSION_COOKIE_NAME="lgh_admin_session"

# App
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Email (SMTP) - optional, used for booking confirmations & contact form
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Lira Grand Hotel <no-reply@liragrandhotel.com>"

# Cloudinary (optional, for image uploads in admin dashboard)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Google Maps (optional, for interactive map embeds)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
